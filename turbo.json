{
  "$schema": "https://turborepo.org/schema.json",
  "envMode": "loose",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "//#config-loom"
      ],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:staged": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:format": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:format:fix": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:style": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "lint:style:fix": {
      "dependsOn": [
        "//#config-loom"
      ]
    },
    "test:benchmark": {
      "dependsOn": [
        "build",
        "//#config-loom"
      ],
      "cache": false
    },
    "test:benchmark:iterators": {
      "dependsOn": [
        "build",
        "//#config-loom"
      ],
      "cache": false
    },
    "//#config-loom": {
      "inputs": [
        "config-loom.yaml",
        "config-loom.yml",
        "pnpm-workspace.yaml",
        ".config-loom/eslint.config.mjs/rule-1.mjs"
      ],
      "outputs": [
        "libs/**/eslint.config.mjs",
        "libs/**/jest.config.js",
        "libs/**/tsconfig.build.json",
        "libs/**/tsconfig.json",
        "libs/**/vitest.config.mts"
      ],
      "cache": true
    }
  }
}
